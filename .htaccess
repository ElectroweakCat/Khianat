# Khianat: compression, caching and a bit of housekeeping

# the raw counter files are only meant for the PHP scripts
<IfModule mod_authz_core.c>
  <FilesMatch "^(poll-data|poll-voters|stats-data)\.json$">
    Require all denied
  </FilesMatch>
</IfModule>

# gzip compression for text-based files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# browser caching for static assets (HTML stays uncached so updates show up)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType audio/wav "access plus 30 days"
  ExpiresByType audio/x-wav "access plus 30 days"
</IfModule>
